# Application Environment Configuration
# Copy this file to .env and replace with your actual values
# NEVER commit the .env file with real credentials

APP_ENV=development
PORT=8000

# MongoDB Atlas Connection String
# Replace YOUR_USERNAME, YOUR_PASSWORD, YOUR_CLUSTER, and YOUR_DATABASE with actual values
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# JWT Secret - Generate a secure random string (minimum 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT Token Expiration (in seconds) - Default: 7 days
JWT_EXPIRES_IN=604800

# CORS Origins - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_API_KEY